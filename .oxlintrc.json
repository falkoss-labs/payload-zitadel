{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["typescript", "react", "import", "vitest"],
    "categories": {
        "correctness": "error",
        "suspicious": "warn"
    },
    "ignorePatterns": ["dist", "dev/src/routeTree.gen.ts", "dev/src/payload-types.ts", "dev/src/app/_payload"],
    "rules": {
        "react/react-in-jsx-scope": "off"
    }
}
