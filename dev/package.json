{
    "name": "dev",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js dev",
        "build": "payload build",
        "payload": "payload",
        "generate:importmap": "payload generate:importmap",
        "generate:types": "payload generate:types",
        "typecheck": "tsc --noEmit",
        "test:e2e": "playwright test",
        "zitadel:up": "docker compose -f zitadel/compose.yaml up -d --wait",
        "zitadel:down": "docker compose -f zitadel/compose.yaml down -v",
        "zitadel:setup": "node --env-file-if-exists=.env zitadel/setup.ts"
    },
    "dependencies": {
        "@falkoss/payload-zitadel": "workspace:*",
        "@payloadcms/db-sqlite": "catalog:payload",
        "@payloadcms/richtext-lexical": "catalog:payload",
        "@payloadcms/tanstack-start": "catalog:payload",
        "@payloadcms/ui": "catalog:payload",
        "@tanstack/react-router": "catalog:",
        "@tanstack/react-start": "catalog:",
        "graphql": "^16.8.1",
        "payload": "catalog:payload",
        "react": "catalog:",
        "react-dom": "catalog:"
    },
    "devDependencies": {
        "@playwright/test": "catalog:",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@vitejs/plugin-react": "catalog:",
        "@vitejs/plugin-rsc": "catalog:",
        "esbuild": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:"
    }
}
